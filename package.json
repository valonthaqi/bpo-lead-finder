    "lucide-react": "^1.69.0",
    "next": "16.4.5",
    "postgres": "4.0.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "robots-parser": "3.0.1",
