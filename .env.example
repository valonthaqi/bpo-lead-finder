# Copy to .env.local and fill in. Never commit .env.local.

# Which search provider the discover step uses. Set once the provider is chosen.
SEARCH_PROVIDER=
SEARCH_API_KEY=

# Path to the local SQLite database file.
DATABASE_PATH=./data/app.db

# Sent as the User-Agent when fetching company websites and directories,
# so site owners can see who is visiting and how to reach us.
FETCH_USER_AGENT="bpo-lead-finder/0.1 (+contact: you@example.com)"
