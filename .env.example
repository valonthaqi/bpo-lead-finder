# Copy to .env.local and fill in. Never commit .env.local.

# Tavily API key from app.tavily.com. The free plan needs no card.
SEARCH_API_KEY=

# Supabase session pooler connection string (port 5432, IPv4). URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Sent as the User-Agent when fetching company websites and directories.
FETCH_USER_AGENT=bpo-lead-finder/0.1

# Supabase Auth, from Project Settings > API Keys. Use the publishable key (sb_publishable_...), never a secret key.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
